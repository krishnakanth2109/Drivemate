{
  "expo": {
    "name": "Drivemate",
    "slug": "drivemate",
    "version": "7.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/App_icon.png",
    "scheme": "drivemate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSLocalNetworkUsageDescription": "Drivemate needs local network access during development to connect to the Metro bundler.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_http._tcp"
        ]
      },
      "bundleIdentifier": "com.drivemate.live",
      "version": "7.0.8",
      "buildNumber": "211"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 211,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/App_icon.png",
        "backgroundColor": "#050831"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.drivemate.live"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SanFranciscoProText/SFProText-Bold.ttf",
            "./assets/fonts/SanFranciscoProText/SFProText-Medium.ttf",
            "./assets/fonts/SanFranciscoProText/SFProText-Regular.ttf",
            "./assets/fonts/SanFranciscoProText/SFProText-Semibold.ttf",
            "./assets/fonts/poppins/Poppins-Bold.ttf",
            "./assets/fonts/poppins/Poppins-Light.ttf",
            "./assets/fonts/poppins/Poppins-SemiBold.ttf",
            "./assets/fonts/poppins/Poppins-Medium.ttf",
            "./assets/fonts/poppins/Poppins-Regular.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true,
            "supportsPageSizes16KB": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "940f7573-eed2-4dd0-970e-dee66193b4cd"
      }
    }
  }
}
